TAVILY_API_KEY="tvly-..."
NEBIUS_API_KEY="..."

# Models are LiteLLM strings (config/models.toml). Other providers need their own key, e.g.
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: a different Nebius Token Factory endpoint
# NEBIUS_API_BASE="https://api.tokenfactory.nebius.com/v1/"

# Optional: also send traces to an OTLP backend, e.g. a local Phoenix (`uvx arize-phoenix serve`)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:6006"
